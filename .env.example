# Atlas connection string (never commit the real one)
MONGODB_URI=mongodb+srv://<user>:<pass>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=recovery
VOYAGE_API_KEY=
MODEL_API_KEY=
# Crash injection, e.g. sent_before_receipt:aws_iam:create_access_key
CRASH_AT=
SMTP_HOST=localhost
SMTP_PORT=1025
ANTHROPIC_API_KEY=
# Live fix demo: suture opens REAL PRs, only on repos listed here
GITHUB_TOKEN=
GITHUB_PR_REPOS=JulianCruzet/suture-demo-api
# Count only these CI checks (use suture-ci with demo/ci_runner.py when GitHub Actions can't run)
GITHUB_CI_ONLY=
# GitHub webhook: red CI on a repo in GITHUB_PR_REPOS starts a fix campaign (POST /webhooks/github)
GITHUB_WEBHOOK_SECRET=
# Laptop with no public URL: the smee.io channel the webhook points at; suture listens to it itself
SMEE_URL=
