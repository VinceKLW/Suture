# Atlas connection string (never commit the real one)
MONGODB_URI=mongodb+srv://<user>:<pass>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=recovery
VOYAGE_API_KEY=
MODEL_API_KEY=
# Crash injection, e.g. sent_before_receipt:aws_iam:create_access_key
CRASH_AT=
SMTP_HOST=localhost
SMTP_PORT=1025
